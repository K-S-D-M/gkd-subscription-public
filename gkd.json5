// ============================================
// GKD（搞快点）个人订阅规则文件
// 语法：JSON5（键名可省略引号，支持单引号和注释）
// 官方格式文档：https://gkd.li/guide/subscription
//
// 方案A说明：
//   1. 标记规则(action:none)：匹配到只记日志，不点击；由外部监听脚本
//      监听日志关键词后按时序执行流程（如微信发图、时钟倒计时等）
//   2. 点击规则(clickCenter)：仅在对应控件出现时点击，安全可用；
//      无 root 设备也可通过 GKD 无障碍服务直接使用
// ============================================

{
  id: 233001,
  name: 'KSDM 个人订阅',
  version: 30,
  author: 'KSDM',
  updateUrl: 'https://k-s-d-m.github.io/gkd-subscription-public/gkd.json5',
  checkUpdateUrl: './gkd.version.json5',
  supportUri: 'https://github.com/K-S-D-M/gkd-subscription-public',
  categories: [],
  globalGroups: [],
  apps: [
    {
      id: 'com.zhihu.android', name: '知乎',
      groups: [
        {
          key: 1,
          name: '开屏广告',
          rules: [
            { matches: '[text="跳过"||text="跳过广告"][visibleToUser=true]' },
          ],
        },
      ],
    },
    {
      id: 'com.zhiyinboke.yinyinting.www',
      name: '听友FM',
      groups: [
        {
          key: 1,
          name: '点击跳过',
          rules: [
            { matches: ['[text="跳过"][visibleToUser=true]'], fastQuery: true, activityIds: ['com.listen.adsdk.ui.SplashAdActivity'] },
          ],
        },
        {
          key: 2,
          name: '点击播放',
          actionMaximum: 1,
          matchTime: 10000,
          resetMatch: 'app',
          rules: [
            { matches: '[desc="播放"]', activityIds: '.activity.MainActivity' },
          ],
        },
      ],
    },
    {
      id: 'com.unionpay',
      name: '云闪付',
      groups: [
        {
          key: 1,
          name: '云闪付查看余额',
          actionMaximum: 1,
          matchTime: 10000,
          resetMatch: 'app',
          rules: [
            { matches: '[desc="显示"]', fastQuery: true, activityIds: '.activity.UPActivityMain' },
          ],
        },
        {
          key: 2,
          name: '关闭',
          rules: [
            { matches: '@ImageView < ViewGroup < ViewGroup < ViewGroup < ViewGroup < ViewGroup < ViewGroup < ViewGroup < ViewGroup < ViewGroup < FrameLayout < RelativeLayout < [id="android:id/content"]', fastQuery: true, activityIds: '.activity.react.UPActivityReactNative' },
          ],
        },
      ],
    },
    {
      id: 'com.ss.android.ugc.aweme',
      name: '抖音',
      groups: [
        {
          key: 1,
          name: '自动连播',
          actionMaximum: 1,
          resetMatch: 'match',
          rules: [
            { matches: '[text="自动连播"] + Switch[checked=false]', fastQuery: true, activityIds: '.main.MainActivity' },
          ],
        },
      ],
    },
    {
      id: 'com.tencent.mm',
      name: '微信',
      groups: [
        {
          key: 1,
          name: '进入中邮封签拍照反馈群（标记）',
          desc: '方案A标记规则(action:none)：微信聊天列表出现「中邮-封签拍照反馈」群时记录日志，由监听脚本自动进入群聊并发送水印照片。不自动点击，避免平时误触',
          action: 'none',
          actionMaximum: 1,
          resetMatch: 'app',
          rules: [
            { matches: '[text="中邮-封签拍照反馈"][visibleToUser=true]', fastQuery: true, activityIds: ['.ui.LauncherUI'] },
          ],
        },
        {
          key: 2,
          name: '微信小程序领取',
          desc: '仅点击提现券奖励卡片(rewardCard/giftContainer)内的「领取」按钮，排除领券槽(coupon-slot)内的领取；文案白名单，避免误触说明文字与「已领取」',
          actionMaximum: 1,
          resetMatch: 'match',
          rules: [
            {
              activityIds: ['.plugin.appbrand.ui.AppBrandPluginUI', '.plugin.appbrand.ui.AppBrandUI'],
              matches: '([id$="--rewardCard"] >n TextView[visibleToUser=true][text="领取"||text="立即领取"||text="马上领取"||text="点击领取"||text="一键领取"]) && !([id$="--home-mch-coupon-slot"] >n TextView[visibleToUser=true][text="领取"||text="立即领取"||text="马上领取"||text="点击领取"||text="一键领取"])',
            },
            {
              activityIds: ['.plugin.appbrand.ui.AppBrandPluginUI', '.plugin.appbrand.ui.AppBrandUI'],
              matches: '([id="giftContainer"] >n TextView[visibleToUser=true][text="领取"||text="立即领取"||text="马上领取"||text="点击领取"||text="一键领取"]) && !([id$="--home-mch-coupon-slot"] >n TextView[visibleToUser=true][text="领取"||text="立即领取"||text="马上领取"||text="点击领取"||text="一键领取"])',
            },
          ],
        },
      ],
    },
    {
      id: 'com.tencent.androidqqmail',
      name: 'QQ邮箱',
      groups: [
        {
          key: 1,
          name: '自动翻译邮件',
          actionMaximum: 1,
          resetMatch: 'match',
          rules: [
            { matches: 'TextView[visibleToUser=true][text="翻译"||text="翻译邮件"]' },
          ],
        },
      ],
    },
    {
      id: 'com.xunmeng.tms',
      name: '多多买菜',
      groups: [
        {
          key: 1,
          name: '点击高德地图',
          desc: '点击规则：Flutter页面常驻监听，弹出地图选择时自动点「高德地图」，支持反复触发',
          actionCd: 1300,
          forcedTime: 86400000,
          resetMatch: 'match',
          rules: [
            { key: 1, action: 'clickCenter', matches: ['View[desc="高德地图"][longClickable=false][visibleToUser=true]'], actionDelay: 300, fastQuery: false, activityIds: ['com.xunmeng.tms.activity.FlutterMainActivity'] },
          ],
        },
        {
          key: 2,
          name: '上传车牌',
          desc: '[ChangeMe]本规则由GKD网页端审查工具生成',
          forcedTime: 86400000,
          rules: [
            { matches: ['[desc="上传车牌"][visibleToUser=true][longClickable=false]'], activityIds: ['com.xunmeng.tms.activity.FlutterMainActivity'] },
          ],
        },
        {
          key: 3,
          name: '更新弹窗',
          desc: '[ChangeMe]本规则由GKD网页端审查工具生成',
          forcedTime: 86400000,
          rules: [
            { matches: ['[vid="cancelImg"][longClickable=false][visibleToUser=true]'], fastQuery: true, activityIds: ['com.xunmeng.tms.activity.FlutterMainActivity'] },
          ],
        },
        {
          key: 5,
          name: '人脸识别',
          desc: '[ChangeMe]本规则由GKD网页端审查工具生成',
          forcedTime: 86400000,
          rules: [
            { matches: ['[desc="人脸认证"][visibleToUser=true][clickable=true]'], activityIds: ['com.xunmeng.tms.activity.FlutterMainActivity'] },
          ],
        },
        {
          key: 6,
          name: '点击出仓库',
          desc: '点击规则：Flutter页面，控件原地属性变化，常驻监听，确认出库状态改变自动点击',
          actionCd: 1300,
          actionMaximum: 1,
          forcedTime: 86400000,
          resetMatch: 'match',
          rules: [
            { key: 1, action: 'clickCenter', matches: ['@[desc="确认出库"][clickable=true][visibleToUser=true]'], actionDelay: 500, fastQuery: false, activityIds: ['com.xunmeng.tms.activity.FlutterMainActivity'] },
          ],
        },
        {
          key: 7,
          name: '导航按钮出现（标记）',
          desc: '方案A标记规则(action:none)：物流司机端主页出现「导航」按钮时记录日志（拍照完成回到主页的信号），监听脚本收到后自动执行后续流程。不自动点击，避免主页被频繁拉起地图选择',
          action: 'none',
          actionCd: 5000,
          forcedTime: 86400000,
          resetMatch: 'match',
          rules: [
            { key: 1, action: 'none', matches: ['View[desc="导航"][clickable=true][visibleToUser=true]'], fastQuery: false, activityIds: ['com.xunmeng.tms.activity.FlutterMainActivity'] },
          ],
        },
      ],
    },
    {
      id: 'com.autonavi.minimap',
      name: '高德地图',
      groups: [
        {
          key: 1,
          name: '自动开始导航（指定地点）',
          desc: '点击规则：「开始导航」按钮持续存在 6 秒后才点击(actionDelay)，且起点或终点必须是白名单中的指定地点，避免误触其他路线',
          activityIds: 'com.autonavi.map.activity.NewMapActivity',
          forcedTime: 30000,
          actionDelay: 6000,
          actionMaximum: 1,
          resetMatch: 'match',
          matchRoot: true,
          rules: [
            {
              key: 1,
              action: 'clickCenter',
              matches: '[desc="开始导航"]',
              anyMatches: [
                '[desc$="江西省南昌市南昌县丁新大道188号"]',
                '[desc$="江西省阀门产品质量检测站"]',
                '[desc$="一路发大型停车场"]',
                '[desc$="江西省南昌市南昌县高新南大道116号"]',
              ],
            },
          ],
        },
        // 导航结束后的行程总结/广告页：识别特征文案后自动返回退出
        {
          key: 2,
          name: '结束导航退出广告页',
          desc: '导航结束后的行程总结+广告页（代驾/酒店/榜单推荐），识别专属文案后自动 back 退出；activityIds 与路线页相同(NewMapActivity)，仅靠文案区分，不会在规划路线/导航中误触发',
          // 只退一次；从非匹配界面切回匹配界面（下次导航结束）才重置
          actionMaximum: 1,
          resetMatch: 'match',
          // 防连退：触发后退回其它页面，冷却 5 秒内不再次匹配
          actionCd: 5000,
          rules: [
            {
              key: 1,
              // back：向系统发起返回事件（官方 action），退出广告页
              action: 'back',
              // 特征文案白名单（快照 1791990170732 实测命中），冗余多文案任一命中即退出：
              //  "找到目的地了吗"：导航结束满意度询问
              //  "最高(公里/小时)"：行程数据标题
              //  "酒后不开车，代驾用高德" / "省心更省钱" / "惊喜优惠，全网比价，一键出发"：代驾广告卡片文案
              // 全部为导航结束页专属、不含动态数字和地名，普通路线页/导航中不出现（路线页快照实测 0 命中）
              // 注意：不加"去看看"等宽泛词，避免路线页沿途推荐卡片误触发返回
              matches: '[text="找到目的地了吗"||text="最高(公里/小时)"||text="酒后不开车，代驾用高德"||text="省心更省钱"||text="惊喜优惠，全网比价，一键出发"]',
              activityIds: 'com.autonavi.map.activity.NewMapActivity',
            },
          ],
        },
      ],
    },
    {
      id: 'com.netease.cloudmusic',
      name: '网易云音乐',
      groups: [
        // 黑胶SVIP升级付费弹窗（识别到使用耳机听歌后弹出）：识别专属文案后自动返回关闭
        {
          key: 1,
          name: '关闭SVIP升级弹窗',
          desc: '识别黑胶SVIP付费弹窗专属文案（协议提示/优惠说明）后自动 back 关闭；弹窗右上角关闭按钮在无障碍树中无文字/desc/id 可匹配（RN 绘制），故用返回键；不用"支付方式/限时特惠"等通用词，避免商城页误触',
          // 只关一次；从非匹配界面切回匹配界面（下次弹窗）才重置
          actionMaximum: 1,
          resetMatch: 'match',
          // 防连退：关闭后退回其它页面，冷却 3 秒内不再次匹配
          actionCd: 3000,
          rules: [
            {
              key: 1,
              // back：向系统发起返回事件（官方 action），关闭弹窗
              action: 'back',
              // 特征文案白名单（快照 1792056133486 实测命中，均为付费弹窗专属）：
              //  "开通前请阅读"：底部协议提示
              //  "优惠仅限1次"：促销说明
              //  "黑胶SVIP·升级N天" 含动态天数不用；"支付方式/限时特惠"通用词不用（防误触）
              matches: '[text="开通前请阅读"||text="优惠仅限1次"]',
              activityIds: 'com.netease.cloudmusic.music.biz.rn.activity.MainProcessLayerReactNativeActivity',
            },
          ],
        },
      ],
    },
  ],
}
