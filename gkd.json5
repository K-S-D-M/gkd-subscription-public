// ============================================
// GKD（搞快点）个人订阅规则文件
// 语法：JSON5（键名可省略引号，支持单引号和注释）
// 官方格式文档：https://gkd.li/guide/subscription
// ============================================

{
  // 订阅唯一 ID（数字，自行指定一个即可，不可与其它订阅重复）
  id: 233001,

  // 订阅名称（显示在 GKD 订阅列表中）
  name: 'KSDM 个人订阅',

  // 订阅版本号（每次更新规则后 +1，用于版本检测）
  version: 15,

  // 作者名称
  author: 'KSDM',

  // 订阅文件远程地址：GKD App 通过此地址拉取订阅
  // 规则源码存于 private 仓库 gkd-subscription，经 GitHub Action 同步到此 public Pages 仓库对外发布
  updateUrl: 'https://k-s-d-m.github.io/gkd-subscription-public/gkd.json5',

  // 版本检测文件地址（相对路径则相对于 updateUrl 所在目录）
  // gkd.version.json5 文件已一并创建，用于快速检查版本号，减少流量消耗
  checkUpdateUrl: './gkd.version.json5',

  // 支持/反馈链接（指向 public 仓库）
  supportUri: 'https://github.com/K-S-D-M/gkd-subscription-public',

  // 规则分类（可选，用于在 GKD 中按分类开关规则组）
  categories: [],

  // 全局规则（不绑定具体 App，对所有应用生效）
  globalGroups: [],

  // 应用规则（每个元素对应一个 App 的规则集合）
  apps: [
    // 示例：知乎开屏广告跳过规则
    {
      id: 'com.zhihu.android', // App 包名（应用信息页可查看）
      name: '知乎',
      groups: [
        {
          key: 1, // 规则组唯一 key（同一 App 内不可重复）
          name: '开屏广告',
          rules: [
            {
              // 匹配规则：查找文本为"跳过"且可见的节点并点击
              // 若你的设备上无效，可参考快照调试后调整 matches 表达式
              matches: '[text*="跳过"][text.length<10][visibleToUser=true]',
            },
          ],
        },
      ],
    },
    // 听友FM：开屏广告跳过规则
    {
      id: 'com.zhiyinboke.yinyinting.www', // App 包名
      name: '听友FM',
      groups: [
        {
          key: 1, // 规则组唯一 key（同一 App 内不可重复）
          name: '点击跳过',
          rules: [
            {
              matches: [
                '[text*="跳过"]',
              ],
              fastQuery: true,
              activityIds: [
                'com.listen.adsdk.ui.SplashAdActivity',
              ],
            },
          ],
        },
        {
          key: 2, // 同一 App 内 key 从 1 递增，已用 1，这里用 2
          name: '点击播放',
          // 限制只点一次：避免 desc 在「播放/暂停」间切换导致反复点击
          matchTime: 10000,
          actionMaximum: 1,
          resetMatch: 'app',
          rules: [
            {
              activityIds: '.activity.MainActivity',
              matches: '[desc="播放"]',
            },
          ],
        },
      ],
    },
    // 云闪付：查看余额（点击显示按钮）
    {
      id: 'com.unionpay', // App 包名
      name: '云闪付',
      groups: [
        {
          key: 1, // 规则组唯一 key（同一 App 内不可重复）
          name: '云闪付查看余额',
          matchTime: 10000,
          actionMaximum: 1,
          resetMatch: 'app',
          rules: [
            {
              fastQuery: true,
              activityIds: '.activity.UPActivityMain',
              matches: '[desc="显示"]',
            },
          ],
        },
        // 云闪付：关闭（React Native 弹窗关闭按钮）
        {
          key: 2,
          name: '关闭',
          rules: [
            {
              fastQuery: true,
              activityIds: '.activity.react.UPActivityReactNative',
              matches:
                '@ImageView < ViewGroup < ViewGroup < ViewGroup < ViewGroup < ViewGroup < ViewGroup < ViewGroup < ViewGroup < ViewGroup < FrameLayout < RelativeLayout < [id="android:id/content"]',
            },
          ],
        },
      ],
    },
    // 抖音：自动连播
    {
      id: 'com.ss.android.ugc.aweme', // App 包名
      name: '抖音',
      groups: [
        {
          key: 1, // 规则组唯一 key（同一 App 内不可重复）
          name: '自动连播',
          rules: [
            {
              fastQuery: true,
              activityIds: '.main.MainActivity',
              // 通过"自动连播"文本定位其右侧的 Switch 开关，仅在未开启(checked=false)时点击，避免误关
              matches: '[text*="自动连播"] + Switch[checked=false]',
            },
          ],
        },
      ],
    },
    // 微信：小程序领取
    {
      id: 'com.tencent.mm', // App 包名
      name: '微信',
      groups: [
        {
          key: 1, // 规则组唯一 key（同一 App 内不可重复）
          name: '微信小程序领取',
          desc: '仅点击领券卡片(rewardCard/giftContainer)内的「领取」按钮；文案白名单，避免误触说明文字与「已领取」',
          // 防误触 + 防反复点击：每次唤醒最多点 1 次，从非匹配界面切回匹配界面时才重置计数
          actionMaximum: 1,
          resetMatch: 'match',
          rules: [
            {
              // 主规则：限定在领券卡片容器内；>n 为"任意深度祖先"，抗小程序改版时多包一层布局
              // id$= 只匹配后缀，抗构建 hash 前缀变化（53e56397--rewardCard → hash 变了仍命中）
              activityIds: '.plugin.appbrand.ui.AppBrandPluginUI',
              matches:
                '[id$="--rewardCard"] >n TextView[visibleToUser=true][text="领取"||text="立即领取"||text="马上领取"||text="点击领取"||text="一键领取"]',
            },
            {
              // 兜底规则：rewardCard 容器被改名时，退到外层礼物容器仍可命中
              activityIds: '.plugin.appbrand.ui.AppBrandPluginUI',
              matches:
                '[id="giftContainer"] >n TextView[visibleToUser=true][text="领取"||text="立即领取"||text="马上领取"||text="点击领取"||text="一键领取"]',
            },
          ],
        },
      ],
    },
    // QQ邮箱：翻译邮件
    {
      id: 'com.tencent.androidqqmail', // App 包名
      name: 'QQ邮箱',
      groups: [
        {
          key: 1, // 规则组唯一 key（同一 App 内不可重复）
          name: '自动翻译邮件',
          rules: [
            {
              // 匹配所有含"翻译"的文本节点并点击
              matches: 'TextView[text*="翻译"]',
            },
          ],
        },
      ],
    },
    // 多多买菜：司机端常见操作（Flutter 页面）
    {
      id: 'com.xunmeng.tms', // App 包名
      name: '多多买菜',
      groups: [
        {
          key: 1,
          name: '点击高德地图',
          desc: 'Flutter页面常驻监听，控件属性变化后自动点击，支持反复触发',
          actionCd: 1300,
          forcedTime: 2200,
          resetMatch: 'match',
          rules: [
            {
              key: 1,
              action: 'clickCenter',
              matches: [
                'View[desc="高德地图"][longClickable=false][visibleToUser=true]',
              ],
              actionDelay: 300,
              fastQuery: false,
              activityIds: [
                'com.xunmeng.tms.activity.FlutterMainActivity',
              ],
            },
          ],
        },
        {
          key: 2,
          name: '上传车牌',
          desc: '[ChangeMe]本规则由GKD网页端审查工具生成',
          rules: [
            {
              matches: [
                '[desc="上传车牌"][visibleToUser=true][longClickable=false]',
              ],
              activityIds: [
                'com.xunmeng.tms.activity.FlutterMainActivity',
              ],
            },
          ],
        },
        {
          key: 3,
          name: '更新弹窗',
          desc: '[ChangeMe]本规则由GKD网页端审查工具生成',
          rules: [
            {
              matches: [
                '[vid="cancelImg"][longClickable=false][visibleToUser=true]',
              ],
              fastQuery: true,
              activityIds: [
                'com.xunmeng.tms.activity.FlutterMainActivity',
              ],
            },
          ],
        },
        {
          key: 5,
          name: '人脸识别',
          desc: '[ChangeMe]本规则由GKD网页端审查工具生成',
          rules: [
            {
              matches: [
                '[desc="人脸认证"][visibleToUser=true][clickable=true]',
              ],
              activityIds: [
                'com.xunmeng.tms.activity.FlutterMainActivity',
              ],
            },
          ],
        },
        {
          key: 6,
          name: '点击出仓库',
          desc: 'Flutter页面，控件原地属性变化，常驻监听，确认出库状态改变自动点击',
          actionCd: 1300,
          forcedTime: 2200,
          resetMatch: 'match',
          // 关键修复：限制最多执行 1 次，防止按钮属性不变导致无限重复点击
          actionMaximum: 1,
          rules: [
            {
              key: 1,
              action: 'clickCenter',
              matches: [
                '@[desc="确认出库"][clickable=true][visibleToUser=true]',
              ],
              actionDelay: 500,
              fastQuery: false,
              activityIds: [
                'com.xunmeng.tms.activity.FlutterMainActivity',
              ],
            },
          ],
        },
      ],
    },
  ],
}