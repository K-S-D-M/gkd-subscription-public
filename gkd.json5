// ============================================
// GKD（搞快点）个人订阅规则文件
// 语法：JSON5（键名可省略引号，支持单引号和注释）
// 官方格式文档：https://gkd.li/guide/subscription
//
// 方案A说明：
//   1. 标记规则(action:none)：匹配到只记日志，不点击；由外部监听脚本
//      监听日志关键词后按时序执行流程（如微信发图、时钟倒计时等）
//   2. 点击规则(clickCenter)：仅在对应控件出现时点击，安全可用；
//      无 root 设备也可通过 GKD 无障碍服务直接使用
// ============================================
{
  id: 233001,
  name: 'KSDM 个人订阅',
  version: 38,
  author: 'KSDM',
  updateUrl: 'https://k-s-d-m.github.io/gkd-subscription-public/gkd.json5',
  checkUpdateUrl: './gkd.version.json5',
  supportUri: 'https://github.com/K-S-D-M/gkd-subscription-public',
  categories: [],
  globalGroups: [],
  apps: [
    {
      id: 'com.zhihu.android', name: '知乎',
      groups: [
        {
          key: 1,
          name: '开屏广告',
          rules: [
            { matches: '[text="跳过"||text="跳过广告"][visibleToUser=true]' },
          ],
        },
      ],
    },
    {
      id: 'com.zhiyinboke.yinyinting.www',
      name: '听友FM',
      groups: [
        {
          key: 1,
          name: '点击跳过',
          rules: [
            { matches: ['[text="跳过"][visibleToUser=true]'], fastQuery: true, activityIds: ['com.listen.adsdk.ui.SplashAdActivity'] },
          ],
        },
        {
          key: 2,
          name: '点击播放',
          actionMaximum: 1,
          matchTime: 10000,
          resetMatch: 'app',
          rules: [
            { matches: '[desc="播放"]', activityIds: '.activity.MainActivity' },
          ],
        },
      ],
    },
    {
      id: 'com.unionpay',
      name: '云闪付',
      groups: [
        {
          key: 1,
          name: '云闪付查看余额',
          actionMaximum: 1,
          matchTime: 10000,
          resetMatch: 'app',
          rules: [
            { matches: '[desc="显示"]', activityIds: '.activity.UPActivityMain' },
          ],
        },
        {
          key: 2,
          name: '关闭',
          rules: [
            { matches: '@ImageView < ViewGroup < ViewGroup < ViewGroup < ViewGroup < ViewGroup < ViewGroup < ViewGroup < ViewGroup < ViewGroup < FrameLayout < RelativeLayout < [id="android:id/content"]', fastQuery: true, activityIds: '.activity.react.UPActivityReactNative' },
          ],
        },
        {
          key: 3,
          name: '每日签到（玩赚中心）',
          desc: '首页右侧悬浮「玩赚中心」入口，一天点一次即可。红框圈的就是这个悬浮按钮；用 id+desc 双重限定，避免点到「专属推荐/本地精彩」里同名卡片或其它悬浮广告。点开后在玩赚中心里做连签签到（本页快照无法覆盖小程序内部，内部签到仍需手动或另配规则）。',
          actionMaximum: 1,
          matchTime: 10000,
          resetMatch: 'app',
          fastQuery: true,
          rules: [
            { matches: '[id="com.unionpay:id/float_view"][desc="玩赚中心"]', activityIds: '.activity.UPActivityMain' },
          ],
        },
      ],
    },
    {
      id: 'com.eg.android.AlipayGphone',
      name: '支付宝',
      groups: [
        {
          key: 1,
          name: '电脑登录确认',
          desc: '支付宝 H5「登录确认」页（即将在电脑上登录XXX）自动点「确认登录」。安全边界：选择器要求「确认登录」按钮紧跟在正文「请确认是否是本人操作」之后（WebView 内相邻节点），只在这套确认模板上生效；actionMaximum + resetMatch:app 保证每次进入支付宝最多自动点 1 次，不会循环。属于授权类操作：电脑端发起登录时手机会直接放行，不需要本人再点。',
          actionMaximum: 1,
          matchTime: 10000,
          resetMatch: 'app',
          fastQuery: true,
          rules: [
            { matches: '[text="请确认是否是本人操作"] + Button[text="确认登录"]', activityIds: '.activity.XRiverActivity' },
          ],
        },
      ],
    },
    {
      id: 'com.ss.android.ugc.aweme',
      name: '抖音',
      groups: [
        {
          key: 1,
          name: '自动连播',
          desc: '仅在刚进抖音时第1个视频生效，①[长按]视频 → ②开启[自动连播]；已开启则按[返回]收尾。不用 forcedTime 长轮询：靠 matchRoot + resetMatch:app，每次进App只跑一轮',
          // 三步流程用 preKeys 串联，不依赖 actionDelay 兜底。
          //
          // 为什么去掉 forcedTime：原先靠 forcedTime: 86400000 全程轮询来找开关，
          // 在抖音主界面这种重界面上会长期低效遍历，拖累同界面其他规则。
          // 现改为「一次性流程」：进 App 时从根节点匹配一轮（matchRoot），
          // 靠 preKeys 串起「长按视频 → 点开关 → 收尾返回」，做完即止。
          //
          // fastQuery: true 成立的原因（判定看「末尾」复合选择器的首属性）：
          //   ① 末尾是 [vid="viewpager"]        → vid  可快查
          //   ② 末尾是 [text="自动连播"]         → text 可快查
          //   ③ 末尾是 [text="自动连播"]         → text 可快查
          // @Switch[clickable=true] 只是关系链里的左侧节点，不影响快查判定。
          matchRoot: true,
          fastQuery: true,
          actionMaximum: 1,
          resetMatch: 'app',
          rules: [
            {
              key: 1,
              name: '①[长按]视频',
              action: 'longClickCenter',
              matches: '[vid="viewpager"][desc="视频"][childCount=2][visibleToUser=true]',
            },
            {
              key: 2,
              preKeys: [1],
              name: '②开启[自动连播]',
              matches: '@Switch[clickable=true][checked=false] - [text="自动连播"]',
            },
            {
              key: 3,
              preKeys: [1],
              name: '③已开启-按[返回键]',
              action: 'back',
              actionMaximumKey: 2,
              matches: '@Switch[clickable=true][checked=true] - [text="自动连播"]',
            },
          ],
        },
      ],
    },
    {
      id: 'com.tencent.mm',
      name: '微信',
      groups: [
        {
          key: 1,
          name: '进入中邮封签拍照反馈群（标记）',
          desc: '方案A标记规则(action:none)：微信聊天列表出现「中邮-封签拍照反馈」群时记录日志，由监听脚本自动进入群聊并发送水印照片。不自动点击，避免平时误触',
          action: 'none',
          actionMaximum: 1,
          resetMatch: 'app',
          rules: [
            { matches: '[text="中邮-封签拍照反馈"][visibleToUser=true]', fastQuery: true, activityIds: ['.ui.LauncherUI'] },
          ],
        },
        {
          key: 2,
          name: '微信小程序领取',
          desc: '仅点击提现券奖励卡片(rewardCard/giftContainer)内的「领取」按钮，排除领券槽(coupon-slot)内的领取；文案白名单，避免误触说明文字与「已领取」',
          actionMaximum: 1,
          resetMatch: 'match',
          rules: [
            {
              activityIds: ['.plugin.appbrand.ui.AppBrandPluginUI', '.plugin.appbrand.ui.AppBrandUI'],
              matches: '([id$="--rewardCard"] >n TextView[visibleToUser=true][text="领取"||text="立即领取"||text="马上领取"||text="点击领取"||text="一键领取"]) && !([id$="--home-mch-coupon-slot"] >n TextView[visibleToUser=true][text="领取"||text="立即领取"||text="马上领取"||text="点击领取"||text="一键领取"])',
            },
            {
              activityIds: ['.plugin.appbrand.ui.AppBrandPluginUI', '.plugin.appbrand.ui.AppBrandUI'],
              matches: '([id="giftContainer"] >n TextView[visibleToUser=true][text="领取"||text="立即领取"||text="马上领取"||text="点击领取"||text="一键领取"]) && !([id$="--home-mch-coupon-slot"] >n TextView[visibleToUser=true][text="领取"||text="立即领取"||text="马上领取"||text="点击领取"||text="一键领取"])',
            },
          ],
        },
      ],
    },
    {
      id: 'com.twitter.android',
      name: 'X',
      groups: [
        {
          key: 1,
          name: '点击翻译',
          desc: '点击帖子下方「翻译帖子」按钮自动翻译。X 为 Compose UI，节点无 id/vid，只能靠 text 精确定位；用白名单枚举避免命中「翻译自越南语」「暂不翻译」等；点击后文案变化，故限制只点一次',
          // 防反复点击：同一帖子翻译按钮点一次即止，切走再回来才重置
          actionMaximum: 1,
          resetMatch: 'match',
          rules: [
            {
              key: 1,
              // 快照 1793820937847（com.x.android.main.MainActivity, 122 节点）实测：
              //   未翻译态 = 「翻译帖子」TextView（clickable=true）
              //   已翻译态 = 「翻译自越南语」(text) + 「显示原文」(clickable=true)
              // 因此必须用精确白名单，禁用 text*= 包含匹配
              activityIds: 'com.x.android.main.MainActivity',
              matches: '[text="翻译帖子"||text="翻译推文"||text="翻译此帖子"][clickable=true][visibleToUser=true]',
            },
          ],
        },
      ],
    },
    {
      id: 'com.tencent.androidqqmail',
      name: 'QQ邮箱',
      groups: [
        {
          key: 1,
          name: '自动翻译邮件',
          actionMaximum: 1,
          resetMatch: 'match',
          rules: [
            { matches: 'TextView[visibleToUser=true][text="翻译"||text="翻译邮件"]' },
          ],
        },
        {
          key: 2,
          name: '批量全标已读',
          activityIds: '.fragment.base.MailFragmentActivity',
          actionMaximum: 1,        // 点一次即可，多选面板底部栏随后消失，防重复触发
          resetMatch: 'match',     // 面板关闭后再次进入视为新一次
          rules: [
            { matches: '[id$="b_k"] >n [text="全标已读"][clickable=true][visibleToUser=true]' },
          ],
        },
      ],
    },
    {
      id: 'com.xunmeng.tms',
      name: '多多买菜',
      groups: [
        {
          key: 1,
          name: '点击高德地图',
          desc: '点击规则：Flutter页面常驻监听，弹出地图选择时自动点「高德地图」，支持反复触发',
          actionCd: 1300,
          forcedTime: 86400000,
          resetMatch: 'match',
          rules: [
            { key: 1, action: 'clickCenter', matches: ['View[desc="高德地图"][longClickable=false][visibleToUser=true]'], actionDelay: 300, fastQuery: false, activityIds: ['com.xunmeng.tms.activity.FlutterMainActivity'] },
          ],
        },
        {
          key: 2,
          name: '上传车牌',
          desc: '[ChangeMe]本规则由GKD网页端审查工具生成',
          forcedTime: 86400000,
          rules: [
            { matches: ['[desc="上传车牌"][visibleToUser=true][longClickable=false]'], activityIds: ['com.xunmeng.tms.activity.FlutterMainActivity'] },
          ],
        },
        {
          key: 3,
          name: '更新弹窗',
          desc: '[ChangeMe]本规则由GKD网页端审查工具生成',
          forcedTime: 86400000,
          rules: [
            { matches: ['[vid="cancelImg"][longClickable=false][visibleToUser=true]'], fastQuery: true, activityIds: ['com.xunmeng.tms.activity.FlutterMainActivity'] },
          ],
        },
        {
          key: 5,
          name: '人脸识别',
          desc: '[ChangeMe]本规则由GKD网页端审查工具生成',
          forcedTime: 86400000,
          rules: [
            { matches: ['[desc="人脸认证"][visibleToUser=true][clickable=true]'], activityIds: ['com.xunmeng.tms.activity.FlutterMainActivity'] },
          ],
        },
        {
          key: 6,
          name: '点击出仓库',
          desc: '点击规则：Flutter页面，控件原地属性变化，常驻监听，确认出库状态改变自动点击',
          actionCd: 1300,
          actionMaximum: 1,
          forcedTime: 86400000,
          resetMatch: 'match',
          rules: [
            { key: 1, action: 'clickCenter', matches: ['@[desc="确认出库"][clickable=true][visibleToUser=true]'], actionDelay: 500, fastQuery: false, activityIds: ['com.xunmeng.tms.activity.FlutterMainActivity'] },
          ],
        },
        {
          key: 7,
          name: '导航按钮出现（标记）',
          desc: '方案A标记规则(action:none)：物流司机端主页出现「导航」按钮时记录日志（拍照完成回到主页的信号），监听脚本收到后自动执行后续流程。不自动点击，避免主页被频繁拉起地图选择',
          action: 'none',
          actionCd: 5000,
          forcedTime: 86400000,
          resetMatch: 'match',
          rules: [
            { key: 1, action: 'none', matches: ['View[desc="导航"][clickable=true][visibleToUser=true]'], fastQuery: false, activityIds: ['com.xunmeng.tms.activity.FlutterMainActivity'] },
          ],
        },
      ],
    },
    {
      id: 'com.autonavi.minimap',
      name: '高德地图',
      groups: [
        {
          key: 1,
          name: '自动开始导航（指定地点）',
          desc: '点击规则：「开始导航」按钮持续存在 6 秒后才点击(actionDelay)，且起点或终点必须是白名单中的指定地点，避免误触其他路线',
          activityIds: 'com.autonavi.map.activity.NewMapActivity',
          forcedTime: 30000,
          actionDelay: 6000,
          actionMaximum: 1,
          resetMatch: 'match',
          matchRoot: true,
          rules: [
            {
              key: 1,
              action: 'clickCenter',
              matches: '[desc="开始导航"]',
              anyMatches: [
                '[desc$="江西省南昌市南昌县丁新大道188号"]',
                '[desc$="江西省阀门产品质量检测站"]',
                '[desc$="一路发大型停车场"]',
                '[desc$="江西省南昌市南昌县高新南大道116号"]',
              ],
            },
          ],
        },
        // 导航结束后的行程总结/广告页：识别特征文案后自动返回退出
        {
          key: 2,
          name: '结束导航退出广告页',
          desc: '导航结束后的行程总结+广告页（代驾/酒店/榜单推荐），识别专属文案后自动 back 退出；activityIds 与路线页相同(NewMapActivity)，仅靠文案区分，不会在规划路线/导航中误触发',
          // 只退一次；从非匹配界面切回匹配界面（下次导航结束）才重置
          actionMaximum: 1,
          resetMatch: 'match',
          // 防连退：触发后退回其它页面，冷却 5 秒内不再次匹配
          actionCd: 5000,
          rules: [
            {
              key: 1,
              // back：向系统发起返回事件（官方 action），退出广告页
              action: 'back',
              // 特征文案白名单（快照 1791990170732 实测命中），冗余多文案任一命中即退出：
              //  "找到目的地了吗"：导航结束满意度询问
              //  "最高(公里/小时)"：行程数据标题
              //  "酒后不开车，代驾用高德" / "省心更省钱" / "惊喜优惠，全网比价，一键出发"：代驾广告卡片文案
              // 全部为导航结束页专属、不含动态数字和地名，普通路线页/导航中不出现（路线页快照实测 0 命中）
              // 注意：不加"去看看"等宽泛词，避免路线页沿途推荐卡片误触发返回
              matches: '[text="找到目的地了吗"||text="最高(公里/小时)"||text="酒后不开车，代驾用高德"||text="省心更省钱"||text="惊喜优惠，全网比价，一键出发"]',
              activityIds: 'com.autonavi.map.activity.NewMapActivity',
            },
          ],
        },
      ],
    },
    {
      id: 'com.netease.cloudmusic',
      name: '网易云音乐',
      groups: [
        // 黑胶SVIP升级付费弹窗（识别到使用耳机听歌后弹出）：识别专属文案后自动返回关闭
        {
          key: 1,
          name: '关闭SVIP升级弹窗',
          desc: '识别黑胶SVIP付费弹窗专属文案（协议提示/优惠说明）后自动 back 关闭；弹窗右上角关闭按钮在无障碍树中无文字/desc/id 可匹配（RN 绘制），故用返回键；不用"支付方式/限时特惠"等通用词，避免商城页误触',
          // 只关一次；从非匹配界面切回匹配界面（下次弹窗）才重置
          actionMaximum: 1,
          resetMatch: 'match',
          // 防连退：关闭后退回其它页面，冷却 3 秒内不再次匹配
          actionCd: 3000,
          rules: [
            {
              key: 1,
              // back：向系统发起返回事件（官方 action），关闭弹窗
              action: 'back',
              // 特征文案白名单（快照 1792056133486 实测命中，均为付费弹窗专属）：
              //  "开通前请阅读"：底部协议提示
              //  "优惠仅限1次"：促销说明
              //  "黑胶SVIP·升级N天" 含动态天数不用；"支付方式/限时特惠"通用词不用（防误触）
              matches: '[text="开通前请阅读"||text="优惠仅限1次"]',
              activityIds: 'com.netease.cloudmusic.music.biz.rn.activity.MainProcessLayerReactNativeActivity',
            },
          ],
        },
      ],
    },
    {
      // 系统界面组件：activityId 为空，没法用 activityIds 限定，只能靠 appId 收口
      id: 'miui.systemui.plugin',
      name: '系统界面组件',
      groups: [
        {
          key: 1,
          name: '音量过高提示',
          desc: '音量调到建议值以上时出现的系统确认弹窗，自动点「确定」。未用 activityIds（该界面 activityId 为空，只能靠 appId 收口）。本轮提交未提供该弹窗快照，选择器仅通过官方引擎语法解析校验，命中面待真机确认。',
          actionMaximum: 1,        // 每次弹窗只点一次"确定"，防重复
          matchTime: 10000,        // 进场 10 秒内有效
          resetMatch: 'match',     // 弹窗消失后再出现视为新一次，可以再点
          rules: [
            {
              // 整条链（从左到右）：
              //   音量提示文案 → 它所在的滚动容器 → 容器的后一个兄弟（按钮栏）→ 按钮栏里的"确定"
              // [text^="..."]      文案前缀匹配，配 id 后缀双限定，不是单靠 text*= 的宽泛包含
              // <<n ScrollView     任意深度子孙（祖先链），文案外再多包一层也不失效
              // + [buttonPanel]    前置兄弟：按钮栏紧跟在滚动区域后面
              // >n [button1]       任意深度祖先内的按钮，不写 > 直接父级
              matches: '[id$="message"][text^="要将音量调高到建议的音量以上吗"] <<n ScrollView + [id$="buttonPanel"] >n [id$="button1"][text="确定"]',
            },
          ],
        },
      ],
    },
  ],
}
